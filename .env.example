# এই ফাইলটি .env নামে কপি করে মানগুলো বদলান:   cp .env.example .env
# (deploy/setup_ubuntu.sh নিজেই কপি করে একটি র‍্যান্ডম পাসওয়ার্ড বসিয়ে দেয়)

# ড্যাশবোর্ডের পাসওয়ার্ড — খালি রাখলে লিংক পাওয়া যে কেউ ঢুকতে পারবে
APP_PASSWORD=change-me

# একজন ব্যবহারকারী সর্বোচ্চ কয়টি ক্যান্ডেল চাইতে পারবে (বেশি হলে সার্ভারে চাপ বাড়ে)
MAX_CANDLES=5000

# সার্ভারের কোন পোর্টে ড্যাশবোর্ড খুলবে
HOST_PORT=8501

# 0.0.0.0   = http://সার্ভারের-IP:8501 এ সরাসরি খোলা যাবে
# 127.0.0.1 = শুধু nginx দিয়ে (ডোমেইন + HTTPS ব্যবহার করলে)
BIND_ADDR=0.0.0.0
